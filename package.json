{
  "name": "project-tokyo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "lint": "npm run lint --workspace=web",
    "typecheck": "npm run typecheck --workspace=web",
    "test": "npm run test --workspace=web && npm run test:scripts && npm test --workspace=@project-tokyo/backend",
    "test:scripts": "node --test scripts/",
    "build": "npm run build --workspace=web",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
