# Public test-network RPC for fork tests and read-only scripts.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Simulated demo JSON store (web). Defaults to /tmp/projecttokyo-demo.json.
DEMO_STATE_PATH=

# Hex private key of the projecttokyo.eth owner / deployer. Never commit the real value.
PROJECTTOKYO_DEPLOYER_KEY=

# Server RPC used by /api/day, the faucet, and generated-wallet broadcasts.
DAY_RPC_URL=

# Exact public origin of the web app (required for POST faucet/broadcast).
# Example: https://project-tokyo-rbt7w.ondigitalocean.app
DAY_APP_ORIGIN=

# Funded EOA that sends gas ETH and transfers test USDC to generated wallets.
# Needs ~1 ETH and ~10,000 USDC (6 decimals) for a live demo.
# Never commit the real value. Circle USDC has no public mint.
DEMO_FAUCET_PRIVATE_KEY=
# Optional overrides (defaults: 0.02 ETH and 250 USDC).
DEMO_FAUCET_ETH_WEI=20000000000000000
DEMO_FAUCET_USDC=250000000
