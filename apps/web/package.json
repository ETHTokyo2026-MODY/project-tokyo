{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenvx run --no-armor --no-native --strict -f .env.production -- next dev",
    "build": "next build",
    "start": "dotenvx run --no-armor --no-native --strict -f .env.production -- next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "env:encrypt": "dotenvx encrypt --no-armor --no-native -f .env.production"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "2.30.0",
    "@wagmi/core": "3.6.5",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.56.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
